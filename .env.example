# Builder organization credentials.
RECLAIM_ORG_SECRET=rorg_replace_me
ORG_ID=00000000-0000-0000-0000-000000000000

# One provider UUID or a comma-separated list. All providers are required and
# execute in order. Leave PROVIDER_VERSION blank for latest; use an exact
# version (1.2.3) or npm semver range (^1.2.0) to pin resolution.
PROVIDER_ID=00000000-0000-0000-0000-000000000000
PROVIDER_VERSION=

BUILDER_API_URL=http://localhost:4001
CALLBACK_PORT=4010
CALLBACK_URL=http://localhost:4010/callback

# Optional external Verification Client. This value must exactly match a
# registered verification_clients.uri. Omit it to use Builder's built-in client.
VERIFICATION_CLIENT_URL=

# Optional client-owned query parameters appended after Builder returns the
# api=2 URL. Builder never receives or manages these values. Do not set api or
# sessionId here. Example for the portal:
# VERIFICATION_CLIENT_QUERY=redirectUrl=https%3A%2F%2Fmerchant.example%2Fdone
VERIFICATION_CLIENT_QUERY=

# Optional result confidentiality. Setup registers only the derived public key.
CAN_USE_ENCRYPTION=false
RECLAIM_ETH_PRIVATE_KEY=

# Optional legacy-compatible TEE session binding. Use only with a TEE-capable
# Verification Client. It uses the same organization-owned Ethereum key.
CAN_BIND_TEE=false
