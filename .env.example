RECLAIM_ORG_SECRET=rorg_replace_me
ORG_ID=00000000-0000-0000-0000-000000000000
PROVIDER_ID=00000000-0000-0000-0000-000000000000
CONSUMER_API_KEY=replace_with_a_random_server_api_key

# Public origin that Builder can reach. The callback path is /callbacks/reclaim.
PUBLIC_URL=http://localhost:3000

# Optional. These defaults use the production Builder and its built-in client.
BUILDER_API_URL=https://build.reclaimprotocol.org
VERIFICATION_CLIENT=builder
PROVIDER_VERSION=
RECLAIM_ETH_PRIVATE_KEY=
PORT=3000
DATABASE_PATH=consumer-demo.sqlite
LOG_LEVEL=info
